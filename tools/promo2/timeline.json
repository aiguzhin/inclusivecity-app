  {
   "id": "l1",
   "t0": 0.9,
   "t1": 2.748,
   "cap": "Лестница, высокий бордюр, гололёд.",
   "trim": 0.0
  },
  {
   "id": "l2",
   "t0": 3.348,
   "t1": 8.066,
   "cap": "Для 750 000 людей с инвалидностью в Казахстане это не мелочь, а стена.",
   "trim": 0.0
  },
  {
   "id": "l3",
   "t0": 8.616,
   "t1": 11.277,
   "cap": "Обычная карта ведёт их прямо к ступеням.",
   "trim": 0.015
  },
  {
   "id": "l4",
   "t0": 12.077,
   "t1": 17.178,
   "cap": "ICity строит маршрут в обход: под коляску, трость, плохое зрение или детскую коляску.",
   "trim": 0.016
  },
  {
   "id": "l5",
   "t0": 17.828,
   "t1": 19.85,
   "cap": "В гололёд обходит скользкие спуски.",
   "trim": 0.0
  },
  {
   "id": "l6",
   "t0": 20.5,
   "t1": 24.11,
   "cap": "Жители отмечают барьер — и маршрут сразу меняется для всех.",
   "trim": 0.0
  },
  {
   "id": "l7",
   "t0": 24.81,
   "t1": 29.349,
   "cap": "Голосовой навигатор. Автобусы, такси и кнопка помощи — в одном приложении.",
   "trim": 0.017
  },
  {
   "id": "l8",
   "t0": 30.049,
   "t1": 34.992,
   "cap": "22 города Казахстана. Бесплатно и без установки.",
   "trim": 0.0
  },
  {
   "id": "l9",
   "t0": 35.892,
   "t1": 38.894,
   "cap": "ICity. Город, в котором можно пройти везде.",
   "trim": 0.0
  }
